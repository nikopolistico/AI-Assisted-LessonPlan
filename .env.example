# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the anon (publishable) key belongs here — it is shipped to the browser
# and is safe to expose because Row Level Security is what protects the data.
# Never put the service_role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Lesson-plan generator. The browser calls the /api/lesson-plan serverless
# function (api/lesson-plan.ts), which holds the real key as a server secret
# and forwards the request — the browser can never call an LLM API directly,
# since providers like OpenAI don't send CORS headers permitting that.
#
# Set these WITHOUT the VITE_ prefix in your Vercel project's environment
# variables (Project Settings → Environment Variables), not here — this file
# is for variables the browser bundle needs, and this key must never reach it.
# For local testing, `vercel dev` reads them from `.env.local` too:
#
#   OPENAI_API_KEY=your-api-key
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=https://api.openai.com/v1   # optional; omit for OpenAI itself
#
# Works with the OpenAI API or any OpenAI-compatible "/v1/chat/completions"
# gateway:
#   OpenAI:    key sk-...      MODEL gpt-4o-mini        (leave BASE_URL unset)
#   kie.ai:    key from kie.ai MODEL gpt-5-2            BASE_URL https://api.kie.ai/gpt-5-2/v1
#   OpenRouter:key sk-or-...   MODEL openai/gpt-4o-mini BASE_URL https://openrouter.ai/api/v1
#
# Optional, browser-visible, display-only — shown on the Generate screen.
# Keep it in sync with OPENAI_MODEL above; it does not control which model runs.
VITE_OPENAI_MODEL=gpt-4o-mini
