# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the anon (publishable) key belongs here — it is shipped to the browser
# and is safe to expose because Row Level Security is what protects the data.
# Never put the service_role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Lesson-plan generator. The key is read by the browser, so only use this build
# where the deployed bundle is not public (local use or a single school). For a
# public deployment, move the call to a Supabase Edge Function and keep the key
# as a server secret instead.
#
# Works with the OpenAI API or any OpenAI-compatible "/v1/chat/completions"
# gateway. The app calls  <VITE_OPENAI_BASE_URL>/chat/completions.
#
#   OpenAI:    key sk-...      MODEL gpt-4o-mini     (leave BASE_URL unset)
#   kie.ai:    key from kie.ai MODEL gpt-5-2         BASE_URL https://api.kie.ai/gpt-5-2/v1
#   OpenRouter:key sk-or-...   MODEL openai/gpt-4o-mini  BASE_URL https://openrouter.ai/api/v1
VITE_OPENAI_API_KEY=your-api-key
VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
